    "Filled is a solid disc with the number cut out; Bordered is a ring with the number inside. %@ starts the count again at 1.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plein est un disque avec le numéro en creux ; Cerclé est un anneau avec le numéro dedans. %@ fait recommencer le compte à 1."
          }
        },
        "nl": {
          "stringUnit": {
