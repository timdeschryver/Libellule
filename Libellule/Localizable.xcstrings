    "With fading ink on, drawings fade out this long after the pen stops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l'encre évanescente, les dessins s'effacent ce délai après l'arrêt du stylo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met vervagende inkt aan vervagen tekeningen zo lang nadat de pen stopt."
          }
        }
      }
    },
    "Your changes haven't been copied, saved or shared yet, and are lost when the window closes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications n'ont pas encore été copiées, enregistrées ni partagées, et seront perdues à la fermeture de la fenêtre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wijzigingen zijn nog niet gekopieerd, bewaard of gedeeld, en gaan verloren als het venster sluit."
          }
        }
      }
    },
    "Zoom in (⌘+)": {
      "localizations": {
