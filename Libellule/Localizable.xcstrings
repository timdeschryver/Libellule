          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Libellule in de menubalk telkens als je inlogt; de lijst zelf staat in Systeeminstellingen › Algemeen › Inlogonderdelen"
          }
        }
      }
    },
    "Start Over…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommencer…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw beginnen…"
          }
        }
      }
    },
    "Start the next annotation session with the drawing the last one ended with": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer la prochaine session d'annotation avec le dessin de la fin de la précédente"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin de volgende annotatiesessie met de tekening waarmee de vorige eindigde"
          }
        }
      }
    },
    "Step Number": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numéro d'étape"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapnummer"
          }
        }
      }
    },
    "Step numbers": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numéros d'étape"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapnummers"
          }
        }
      }
    },
    "Step numbers start again at 1": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros d'étape recommencent à 1"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapnummers beginnen opnieuw bij 1"
          }
        }
      }
    },
    "Stores the visible image and searchable text after redaction. Keeps up to 100 recent captures; favorites stay until deleted. Turning history off stops new saves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve l’image visible et le texte recherchable après masquage. Garde jusqu’à 100 captures récentes ; les favoris restent jusqu’à leur suppression. Désactiver l’historique arrête les nouveaux enregistrements."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart het zichtbare beeld en doorzoekbare tekst na afdekking. Bewaart tot 100 recente opnamen; favorieten blijven tot verwijdering. Geschiedenis uitschakelen stopt nieuwe opslag."
          }
        }
      }
    },
    "Swap": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permuter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omwisselen"
          }
        }
      }
    },
    "System-wide": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans tout le système"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeembreed"
          }
        }
      }
    },
    "Table": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableau"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabel"
          }
        }
      }
    },
    "Table %lld": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableau %lld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabel %lld"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst"
          }
        }
      }
    },
    "Text Background": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fond du texte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstachtergrond"
          }
        }
      }
    },
    "Text Blocks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocs de texte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstblokken"
          }
        }
      }
    },
    "Text or pattern to hide": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte ou motif à masquer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te verbergen tekst of patroon"
          }
        }
      }
    },
    "The board the screen was annotated on: switch it off to show the picture underneath": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau sur lequel l'écran a été annoté : désactivez-le pour montrer l'image dessous"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bord waarop het scherm is geannoteerd: schakel het uit om de afbeelding eronder te tonen"
          }
        }
      }
    },
    "The clipboard does not contain an image or an image file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers ne contient ni image ni fichier image."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het klembord bevat geen afbeelding of afbeeldingsbestand."
          }
        }
      }
    },
    "The colour and size are always remembered from last time, for the screen and for screenshots separately.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur et la taille sont toujours retenues de la dernière fois, séparément pour l'écran et pour les captures."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kleur en de grootte worden altijd onthouden van de vorige keer, apart voor het scherm en voor schermafbeeldingen."
          }
        }
      }
    },
    "The colour of the pointer mark and the click ripples": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur du repère du pointeur et des ondes de clic"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kleur van de aanwijzermarkering en de klikkringen"
          }
        }
      }
    },
    "The digits pick tools": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres choisissent les outils"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De cijfers kiezen gereedschappen"
          }
        }
      }
    },
    "The menu next to Screenshot on the capture bar changes what happens after capturing too (O steps through it), and keeps that choice for next time. With the freeze off, the screen keeps moving under the selection and the picture is taken the moment you release the area or click a window; the capture bar's Live button (L) switches this for one capture. Hold ⌥ while clicking a window to do the opposite of the shadow setting. In the editor, ⌘C copies and ⌘S saves at any time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menu à côté de Capture d'écran sur la barre de capture change aussi ce qui se passe après la capture (O fait défiler les choix) et retient ce choix pour la prochaine fois. Sans figer, l'écran continue de bouger sous la sélection et l'image est prise au moment où vous relâchez la zone ou cliquez une fenêtre ; le bouton En direct de la barre (L) change cela pour une capture. Maintenez ⌥ en cliquant une fenêtre pour l'inverse du réglage de l'ombre. Dans l'éditeur, ⌘C copie et ⌘S enregistre à tout moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het menu naast Schermafbeelding op de opnamebalk wijzigt ook wat er na het vastleggen gebeurt (O loopt de keuzes af) en onthoudt die keuze voor de volgende keer. Zonder bevriezen blijft het scherm onder de selectie bewegen en wordt de afbeelding gemaakt op het moment dat je het gebied loslaat of op een venster klikt; de knop Live op de opnamebalk (L) wisselt dit voor één opname. Houd ⌥ ingedrukt bij het klikken op een venster voor het omgekeerde van de schaduwinstelling. In de editor kopieert ⌘C en bewaart ⌘S op elk moment."
          }
        }
      }
    },
    "The radius of the bright circle that follows the pointer while the lights are dimmed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rayon du cercle lumineux qui suit le pointeur quand les lumières sont tamisées"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De straal van de lichte cirkel die de aanwijzer volgt terwijl de lichten gedimd zijn"
          }
        }
      }
    },
    "The radius of the mark on the pointer": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rayon du repère sur le pointeur"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De straal van de markering op de aanwijzer"
          }
        }
      }
    },
    "The save panel starts with this format and lets you switch it per file. Copying, dragging and sharing always hand over a PNG.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre d'enregistrement propose ce format et permet d'en changer par fichier. Copier, glisser et partager transmettent toujours un PNG."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bewaarvenster begint met deze structuur en laat je die per bestand wijzigen. Kopiëren, slepen en delen geven altijd een PNG door."
          }
        }
      }
    },
    "The sections must have the same pixel width. Capture the same area on the same display each time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sections doivent avoir la même largeur en pixels. Capturez la même zone sur le même écran à chaque fois."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De secties moeten even breed zijn in pixels. Leg telkens hetzelfde gebied op hetzelfde scherm vast."
          }
        }
      }
    },
    "The spotlight is the bright circle that follows the pointer while the lights are dimmed (%@ cycles through lights on, dimmed and spotlight).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projecteur est le cercle lumineux qui suit le pointeur quand les lumières sont tamisées (%@ passe de lumières allumées à tamisées puis projecteur)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spot is de lichte cirkel die de aanwijzer volgt terwijl de lichten gedimd zijn (%@ wisselt tussen lichten aan, gedimd en spot)."
          }
        }
      }
    },
    "The tool in hand at the start: whichever was used last time, or always the same one": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'outil en main au départ : celui de la dernière fois, ou toujours le même"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gereedschap bij de start: wat de vorige keer werd gebruikt, of altijd hetzelfde"
          }
        }
      }
    },
    "The tool used last": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier outil utilisé"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het laatst gebruikte gereedschap"
          }
        }
      }
    },
    "Then: open the editor, copy to the clipboard, or save to a file (O switches; remembered for next time)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite : ouvrir l'éditeur, copier dans le presse-papiers, ou enregistrer dans un fichier (O change ; retenu pour la prochaine fois)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna: open de editor, kopieer naar het klembord, of bewaar in een bestand (O wisselt; onthouden voor de volgende keer)"
          }
        }
      }
    },
    "These work while the editor or the screen overlay has the keyboard. A key on its own, or with ⌘, ⌥ or ⌃; ⇧ is ignored so the digits work on every keyboard. The colours keep their letters (R O Y G B P W K), the digits 1–9 and 0 pick the shapes in toolbar order, and ⌘Z, ⌘A, ⌘C, ⌘X, ⌘V and ⌘D are fixed. Loupe, fading ink, board, hiding, live and the palette apply to the screen only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles agissent quand l'éditeur ou le calque d'écran a le clavier. Une touche seule, ou avec ⌘, ⌥ ou ⌃ ; ⇧ est ignoré pour que les chiffres marchent sur tous les claviers. Les couleurs gardent leurs lettres (R O Y G B P W K), les chiffres 1–9 et 0 choisissent les formes dans l'ordre de la barre, et ⌘Z, ⌘A, ⌘C, ⌘X, ⌘V et ⌘D sont fixes. Loupe suiveuse, encre évanescente, tableau, masquage, direct et palette ne s'appliquent qu'à l'écran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze werken terwijl de editor of de schermlaag het toetsenbord heeft. Een toets alleen, of met ⌘, ⌥ of ⌃; ⇧ wordt genegeerd zodat de cijfers op elk toetsenbord werken. De kleuren houden hun letters (R O Y G B P W K), de cijfers 1–9 en 0 kiezen de vormen in de volgorde van de balk, en ⌘Z, ⌘A, ⌘C, ⌘X, ⌘V en ⌘D liggen vast. Loep, vervagende inkt, bord, verbergen, live en het palet gelden alleen op het scherm."
          }
        }
      }
    },
    "They work even while Libellule is in the background. Use at least one of ⌘, ⌥ or ⌃. While annotating the screen, the capture shortcut keeps the drawing as a screenshot. Repeat retakes the area of the previous capture without asking again; the delayed capture counts down three seconds first, so a menu can be opened in time, and pressing it again during the countdown cancels it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils fonctionnent même quand Libellule est en arrière-plan. Utilisez au moins l'une des touches ⌘, ⌥ ou ⌃. Pendant l'annotation de l'écran, le raccourci de capture garde le dessin comme capture. Répéter reprend la zone de la capture précédente sans redemander ; la capture différée compte trois secondes d'abord, le temps d'ouvrir un menu, et le presser à nouveau pendant le compte à rebours l'annule."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze werken ook als Libellule op de achtergrond staat. Gebruik minstens een van ⌘, ⌥ of ⌃. Tijdens het annoteren van het scherm bewaart de opnamesneltoets de tekening als schermafbeelding. Herhalen neemt het gebied van de vorige opname opnieuw zonder te vragen; de uitgestelde opname telt eerst drie seconden af, zodat een menu op tijd open kan, en nogmaals drukken tijdens het aftellen annuleert."
          }
        }
      }
    },
    "Thick": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épais"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dik"
          }
        }
      }
    },
    "Thicker (preset)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus épais (préréglage)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikker (voorinstelling)"
          }
        }
      }
    },
    "Thin": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dun"
          }
        }
      }
    },
    "Thinner (preset)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus fin (préréglage)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunner (voorinstelling)"
          }
        }
      }
    },
    "This file could not be read as an image or a Libellule project.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne peut pas être lu comme une image ou un projet Libellule."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kan niet als afbeelding of Libellule-project worden gelezen."
          }
        }
      }
    },
    "This image is too large. Use an image up to 32768 pixels per side and 100 million pixels in total.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image est trop grande. Utilisez une image de 32768 pixels maximum par côté et de 100 millions de pixels au total."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze afbeelding is te groot. Gebruik een afbeelding van maximaal 32768 pixels per zijde en 100 miljoen pixels in totaal."
          }
        }
      }
    },
    "This is version %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is versie %@"
          }
        }
      }
    },
    "This regular expression is invalid and will not run.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette expression régulière est invalide et ne sera pas exécutée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze reguliere expressie is ongeldig en wordt niet uitgevoerd."
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outils"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedschappen"
          }
        }
      }
    },
    "Top": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven"
          }
        }
      }
    },
    "Transparent": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparant"
          }
        }
      }
    },
    "Try a tighter capture around the table, or copy the text blocks.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une capture plus serrée autour du tableau ou copiez les blocs de texte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een strakkere opname rond de tabel of kopieer de tekstblokken."
          }
        }
      }
    },
    "Turn Libellule on under Login Items to finish": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Libellule sous Éléments d'ouverture pour terminer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Libellule in bij Inlogonderdelen om af te ronden"
          }
        }
      }
    },
    "Turn on Libellule under System Settings › Privacy & Security › Screen & System Audio Recording. macOS applies the change only to a freshly started app, so quit and reopen Libellule afterwards.\n\nIf Libellule is already switched on there, just quit and reopen it. If it isn't listed, click + below the list and choose the app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Libellule dans Réglages Système › Confidentialité et sécurité › Enregistrement de l'écran et de l'audio système. macOS n'applique le changement qu'à une app fraîchement lancée : quittez et rouvrez Libellule ensuite.\n\nSi Libellule y est déjà activé, quittez-le et rouvrez-le. S'il n'est pas listé, cliquez + sous la liste et choisissez l'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Libellule in bij Systeeminstellingen › Privacy en beveiliging › Scherm- en systeemaudio-opname. macOS past de wijziging alleen toe op een pas gestarte app: stop Libellule daarna en open het opnieuw.\n\nAls Libellule daar al is ingeschakeld, stop het dan en open het opnieuw. Staat het er niet bij, klik dan op + onder de lijst en kies de app."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel"
          }
        }
      }
    },
    "Undo (⌘Z)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler (⌘Z)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel (⌘Z)"
          }
        }
      }
    },
    "Undo (⌘Z, or the mouse's back button)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler (⌘Z, ou le bouton précédent de la souris)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel (⌘Z, of de terugknop van de muis)"
          }
        }
      }
    },
    "Update Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiser l’aperçu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld bijwerken"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Use Libellule's menu → Make Pinned Screenshots Interactive to restore mouse interaction": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le menu de Libellule → Réactiver les captures épinglées pour rétablir les interactions de la souris"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het menu van Libellule → Vastgezette schermafbeeldingen interactief maken om muisinteractie te herstellen"
          }
        }
      }
    },
    "Use Side by Side, or crop the screenshots to matching dimensions in the editor.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Côte à côte ou recadrez les captures aux mêmes dimensions dans l’éditeur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Naast elkaar of snijd de schermafbeeldingen in de editor bij tot gelijke afmetingen."
          }
        }
      }
    },
    "View": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave"
          }
        }
      }
    },
    "What fills the space added around the picture": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui remplit l'espace ajouté autour de l'image"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de ruimte rond de afbeelding vult"
          }
        }
      }
    },
    "What happens with a screenshot once the area or window is chosen": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'il advient d'une capture une fois la zone ou la fenêtre choisie"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat er met een schermafbeelding gebeurt zodra het gebied of venster gekozen is"
          }
        }
      }
    },
    "Where the tool palette sits while annotating the screen": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où se place la palette d'outils pendant l'annotation de l'écran"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar het gereedschapspalet staat tijdens het annoteren van het scherm"
          }
        }
      }
    },
    "While drawing: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessinant : %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het tekenen: %@"
          }
        }
