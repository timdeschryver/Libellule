          }
        }
      }
    },
    "Choose a preset in the Save panel. Size and padding are in pixels; zero leaves a dimension unrestricted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un préréglage dans la fenêtre d’enregistrement. Dimensions et marges sont en pixels ; zéro ne limite pas la dimension."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een voorinstelling in het bewaarvenster. Afmetingen en marge zijn in pixels; nul laat een afmeting onbeperkt."
          }
        }
      }
    },
    "Choose an area, a window or a whole screen to capture (%@)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une zone, une fenêtre ou un écran entier à capturer (%@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een gebied, een venster of een heel scherm om vast te leggen (%@)"
          }
        }
      }
    },
    "Choose sections in order from top to bottom. You can adjust every join afterwards.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les sections de haut en bas. Vous pourrez ajuster chaque raccord ensuite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies secties van boven naar beneden. U kunt elke overgang achteraf aanpassen."
