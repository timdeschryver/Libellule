    "Check this join. Zero concatenates sections without removing overlap.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez ce raccord. Zéro juxtapose les sections sans supprimer le chevauchement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer deze overgang. Nul voegt secties samen zonder overlap te verwijderen."
